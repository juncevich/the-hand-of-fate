# Copy to .env and fill in values

# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram bot username (without @) — shown in the Settings page link token flow
VITE_BOT_USERNAME=

# Shared secret authenticating the bot's gRPC calls to the backend.
# Must match between backend and bot. Change before any real deployment.
GRPC_SHARED_SECRET=dev-grpc-shared-secret-for-testing-only

# Social login through Keycloak (optional). A provider shows up on the sign-in page only when its
# client id is set; applied to the realm by keycloak-config (compose) / the keycloak-config Job (k8s).
# Redirect URI to register with the provider: <app origin>/auth/realms/fate/broker/<google|github|yandex>/endpoint
#   e.g. http://localhost:3000/auth/realms/fate/broker/google/endpoint (dev-start.sh),
#        http://localhost:30080/auth/realms/fate/broker/google/endpoint (minikube)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=

# Used by docker-compose only — all other env vars have defaults for local dev
