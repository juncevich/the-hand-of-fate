# Copy to .env and fill in values

# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram bot username (without @) — shown in the Settings page link token flow
VITE_BOT_USERNAME=

# Shared secret authenticating the bot's gRPC calls to the backend.
# Must match between backend and bot. Change before any real deployment.
GRPC_SHARED_SECRET=dev-grpc-shared-secret-for-testing-only

# Used by docker-compose only — all other env vars have defaults for local dev
