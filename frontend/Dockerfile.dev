# Vite dev server for the Tilt loop (make k8s-dev). Tilt syncs src/ and public/ into the
# running container and Vite hot-reloads; a dependency change rebuilds the image.
# Production image: Dockerfile.
FROM node:26-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 3000

# /api never reaches Vite here: the gateway routes it to the backend Service.
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "3000", "--strictPort"]
